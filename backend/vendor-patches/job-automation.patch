+import os, re, subprocess
+
+def is_ci() -> bool:
+    return os.getenv("CI") == "true" or os.getenv("GITHUB_ACTIONS") == "true"
+
+def _chrome_major() -> str:
+    exe = os.getenv("JOBHUB_CHROME", "")
+    try:
+        out = subprocess.run([exe, "--version"], capture_output=True, text=True, timeout=10).stdout
+        return re.search(r"(\d+)\.", out).group(1)
+    except Exception:
+        return "156"
+
+def get_browser_options() -> dict:
+    # job-hub patch: bundled Chromium (PLAYWRIGHT_BROWSERS_PATH); JOBHUB_HEADLESS=1 runs fully in the background.
+    headless = os.getenv("JOBHUB_HEADLESS", "1") == "1"
+    opts = {"headless": headless, "args": ["--disable-blink-features=AutomationControlled"]}
+    if headless:
+        # Full Chromium in new-headless mode (not the stripped headless shell) with a normal desktop UA,
+        # so sites serve the same pages as a visible browser.
+        opts["channel"] = "chromium"
+        opts["user_agent"] = (f"Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) "
+                              f"Chrome/{_chrome_major()}.0.0.0 Safari/537.36")
+    if is_ci():
+        opts["args"] += ["--no-sandbox", "--disable-dev-shm-usage"]
+    return opts
