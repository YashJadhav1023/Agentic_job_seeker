# Copy to .env (or run ./setup.sh, which generates the random values). Never commit .env.

# Public DNS name pointing at this VM (A record). Caddy gets a Let's Encrypt cert for it automatically.
JOBHUB_DOMAIN=jobs.example.com

# Bearer token the Android app sends. >= 32 chars:  openssl rand -hex 32
JOBHUB_API_TOKEN=

# Remote browser (noVNC) used to log in to LinkedIn/Naukri/Indeed from your phone.
JOBHUB_VNC_PASSWORD=
JOBHUB_BROWSER_USER=jobhub
# bcrypt hash of the browser password, with every "$" doubled to "$$" (setup.sh does this for you):
JOBHUB_BROWSER_HASH=

# Optional: set the Gmail app password here instead of uploading it from the app (Settings > Secrets).
# JOBHUB_SECRET_GMAIL_APP_PASSWORD=

# Set to 1 to hide the interactive /docs page.
JOBHUB_DISABLE_DOCS=0
