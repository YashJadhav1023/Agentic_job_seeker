{$JOBHUB_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}

	# Remote browser (noVNC) for signing in to job sites. No login prompts: the app asks the API for a single-use link
	# (POST /api/v1/browser/session); opening it sets a signed 30-minute cookie that is checked here on every request,
	# including the websocket. Without the cookie the API answers 401 and nothing reaches noVNC.
	handle_path /browser/* {
		forward_auth jobhub:8000 {
			uri /internal/browser-auth
		}
		reverse_proxy jobhub:6080
	}

	# API + MCP (bearer-token auth enforced by the app). Long timeouts for slow tools like search_jobs.
	handle {
		request_body {
			max_size 8MB
		}
		reverse_proxy jobhub:8000 {
			transport http {
				read_timeout 300s
				write_timeout 300s
			}
		}
	}

	log {
		output stdout
		format console
	}
}
