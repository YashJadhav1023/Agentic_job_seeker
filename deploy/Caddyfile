{$JOBHUB_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}

	# Remote browser (noVNC) for signing in to job sites. No login prompts: the app asks the API for a single-use link
	# (POST /api/v1/browser/session); opening it sets a signed 30-minute cookie that is checked here on every request,
	# including the websocket. Without the cookie the API answers 401 and nothing reaches noVNC.
	handle_path /browser/* {
		forward_auth jobhub:8000 {
			uri /internal/browser-auth
			# The auth check must be a plain GET. Without this the noVNC websocket's Upgrade headers are copied onto
			# it, the API sees a websocket handshake for a route that has none and answers 403, and noVNC stays on
			# its "Connect" page instead of showing the sign-in browser.
			header_up -Upgrade
			header_up -Connection
			header_up -Sec-WebSocket-Key
			header_up -Sec-WebSocket-Version
			header_up -Sec-WebSocket-Extensions
		}
		reverse_proxy jobhub:6080
	}

	# API + MCP (bearer-token auth enforced by the app). Long timeouts for slow tools like search_jobs.
	handle {
		request_body {
			max_size 8MB
		}
		reverse_proxy jobhub:8000 {
			transport http {
				read_timeout 300s
				write_timeout 300s
			}
		}
	}

	log {
		output stdout
		format console
	}
}
